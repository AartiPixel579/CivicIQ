# CivicIQ Environment Configuration
# Official Tagline: Your Edison Township Buddy

# Municipality
MUNICIPALITY_NAME=Township of Edison, New Jersey

# Vector Store (pgvector / SQLite fallback)
# Leave empty to use the built-in SQLite vector store fallback:
DATABASE_URL=
VECTOR_STORE_PROVIDER=pgvector
SIMILARITY_THRESHOLD=0.075
EMBEDDING_DIM=128

# Free-First LLM Provider Architecture
# Fallback Priority: Google Gemini -> Groq -> OpenRouter (Free Only) -> Deterministic Synthesis
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDERS=groq,openrouter
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# 1. Primary: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 2. First Backup: Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Second Backup: OpenRouter (Strictly Free Tier)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_ALLOW_FREE_MODELS_ONLY=true

# Admin Ingestion Protection Key (Generate a random 32+ character secret)
ADMIN_API_KEY=replace_with_a_strong_random_secret
