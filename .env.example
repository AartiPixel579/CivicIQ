# PostgreSQL / pgvector Connection
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/civiciq
VECTOR_STORE_PROVIDER=pgvector

# RAG & Embeddings
SIMILARITY_THRESHOLD=0.075
EMBEDDING_DIM=128

# LLM Providers (Google Gemini preferred; Groq / OpenAI as alternative)
# Primary (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Fallback / Alternative (Groq / OpenAI endpoint)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
