# CivicIQ Environment Configuration Template
# Official Tagline: Your Edison Township Buddy
# Copy this file to .env for local development, or enter these keys in Render & Vercel.

# Municipality Metadata
MUNICIPALITY_NAME=Township of Edison, New Jersey

# Vector Store & Database Configuration
# For production (Render + Supabase PostgreSQL with pgvector):
# DATABASE_URL=postgresql://postgres:[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# In local development (ENVIRONMENT=development), leaving DATABASE_URL empty uses built-in SQLite.
DATABASE_URL=
VECTOR_STORE_PROVIDER=pgvector
SIMILARITY_THRESHOLD=0.075
EMBEDDING_DIM=128

# AI Provider Architecture
# Fallback Priority: Google Gemini (Primary) -> Groq (Fallback) -> Grounded Deterministic Retrieval
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDERS=groq
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# 1. Primary: Google Gemini API (Get free key at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 2. Fallback: Groq API (Get free developer key at: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Admin Ingestion Protection Key (Generate a random 32+ character secret)
ADMIN_API_KEY=replace_with_a_strong_random_secret

# Configurable Official Website Crawler & Incremental Updates
TRUSTED_ROOT_URL=https://www.edisonnj.org/document_center/index.php
CRAWL_MAX_DEPTH=2
CRAWL_MAX_PAGES=80
CRAWL_DELAY_SECONDS=0.5
CRAWL_TIMEOUT_SECONDS=15
CRAWL_MAX_PDF_MB=20
CRAWL_MISS_THRESHOLD=2
CRAWL_FREQUENCY_HOURS=24
INCREMENTAL_UPDATE_ENABLED=false

# Production Environment & CORS Security
ENVIRONMENT=production
ALLOWED_ORIGINS=https://your-civiciq-app.vercel.app,http://localhost:3000

# ---------------------------------------------------------------------------
# Frontend Configuration (Configure in Vercel Dashboard Settings -> Environment Variables)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=https://your-civiciq-backend.onrender.com
# BACKEND_INTERNAL_URL=https://your-civiciq-backend.onrender.com
