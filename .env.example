# CivicIQ Environment Configuration Template
# Official Tagline: Your Edison Township Buddy
# Copy this file to .env for local development, or enter these keys in Render & Vercel.

# Municipality Metadata
MUNICIPALITY_NAME=Township of Edison, New Jersey

# Vector Store & Database Configuration
# For Render + hosted PostgreSQL (Supabase, Neon, or Render Postgres with pgvector):
# DATABASE_URL=postgresql://postgres:your_password@your_host:5432/your_database
# If left empty, CivicIQ automatically operates using its built-in SQLite vector store fallback.
DATABASE_URL=
VECTOR_STORE_PROVIDER=pgvector
SIMILARITY_THRESHOLD=0.075
EMBEDDING_DIM=128

# Free-First LLM Provider Architecture
# Fallback Priority: Google Gemini -> Groq -> OpenRouter (Free Only) -> Deterministic Synthesis
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDERS=groq,openrouter
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# 1. Primary: Google Gemini API (Get free key at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# 2. First Backup: Groq API (Get free developer key at: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Second Backup: OpenRouter API (Get free key at: https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_ALLOW_FREE_MODELS_ONLY=true

# Admin Ingestion Protection Key (Generate a random 32+ character secret)
ADMIN_API_KEY=replace_with_a_strong_random_secret

# Production Environment & CORS Security
ENVIRONMENT=production
ALLOWED_ORIGINS=https://your-civiciq-app.vercel.app,http://localhost:3000

# ---------------------------------------------------------------------------
# Frontend Configuration (Configure in Vercel Dashboard Settings -> Environment Variables)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=https://your-civiciq-backend.onrender.com
