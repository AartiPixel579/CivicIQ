# CivicIQ Frontend Environment Variables
# Public API base URL used for client-side fetches (e.g., https://civiciq-backend.onrender.com)
NEXT_PUBLIC_API_URL=

# Internal backend URL used by Next.js server rewrites (optional; defaults to NEXT_PUBLIC_API_URL or http://127.0.0.1:8000)
BACKEND_INTERNAL_URL=
